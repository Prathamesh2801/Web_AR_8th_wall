# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Brand reference material: brand-assets/<brand>/ is committed (README, label/sticker
# artwork = input to `npm run generate-targets`, reference/ screenshots), except raw
# photos/ (large, local only).
brand-assets/*/photos/

# Local HTTPS certificates generated by vite-plugin-mkcert.
.vite-plugin-mkcert/

# Meshy originals (up to ~100 MB); the optimised copies live in public/brands/<brand>/models
raw-assests/
raw-output/
# Meshy source models kept next to the brand (input to scripts/optimize-model.mjs), too big for git
brand-assets/*/models/*-source.glb
